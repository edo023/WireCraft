// Il sito di WireCraft (cartella sito/) su Cloudflare Workers, solo file statici.
// Ogni push su main lo ripubblica (Workers Builds: npx wrangler deploy).
{
  "name": "wirecraft",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./sito",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Solo il dominio vero: niente copie su *.workers.dev da indicizzare.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "wirecraft.alfredopennisi.com", "custom_domain": true }
  ]
}
