+/// A textbox boundary (92 bit 8, often also flagged external: 92 = 9) is a hole around text in
+/// the hatch, never an area to fill: title blocks keep such boxes over their fields, and with the
+/// outer style they were filled as solid boxes over the text.
+#[test]
+fn hatch_textbox_loops_are_not_filled() {
+    // The arrow: a polyline loop (92 = 22); the text boxes: line-edge loops (92 = 9).
+    let arrow = "92\n22\n72\n0\n73\n1\n93\n4\n10\n0\n20\n0\n10\n2\n20\n0\n10\n2\n20\n2\n10\n0\n20\n2\n97\n0\n";
+    let textbox = |x: f64| {
+        let (x1, y1) = (x + 5.0, 2.0);
+        format!("92\n9\n93\n4\n72\n1\n10\n{x}\n20\n0\n11\n{x1}\n21\n0\n72\n1\n10\n{x1}\n20\n0\n11\n{x1}\n21\n{y1}\n72\n1\n10\n{x1}\n20\n{y1}\n11\n{x}\n21\n{y1}\n72\n1\n10\n{x}\n20\n{y1}\n11\n{x}\n21\n0\n97\n0\n")
+    };
+    let text = format!(
+        "0\nSECTION\n2\nENTITIES\n0\nHATCH\n8\n0\n10\n0\n20\n0\n30\n0\n210\n0\n220\n0\n230\n1\n2\nSOLID\n70\n1\n71\n0\n91\n3\n\
+         {arrow}{}{}75\n1\n76\n1\n98\n0\n0\nENDSEC\n0\nEOF\n",
+        textbox(-3.0),
+        textbox(1.0)
+    );
+    let d = read(text.as_bytes(), "h.dxf").unwrap();
+    let h = hatches(&d);
+    assert_eq!(h.len(), 1);
+    assert_eq!(h[0].loops.len(), 1, "only the arrow is filled");
+    assert!((h[0].loops[0].vertices[1].p.x - 2.0).abs() < 1e-9);
+}
