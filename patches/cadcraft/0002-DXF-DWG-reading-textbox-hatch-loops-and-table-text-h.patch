+/// The most common height of the texts among `ents` (to 0.001), if there are any.
+fn common_text_height<'a>(ents: impl Iterator<Item = &'a Entity>) -> Option<f64> {
+    let mut counts: HashMap<i64, usize> = HashMap::new();
+    for e in ents {
+        let h = match &e.kind {
+            EntityKind::Text(t) => t.height,
+            EntityKind::MText(m) => m.height,
+            _ => continue,
+        };
+        if h.is_finite() && h > 0.0 && h < 1e9 {
+            *counts.entry((h * 1000.0).round() as i64).or_default() += 1;
+        }
+    }
+    counts.into_iter().max_by_key(|&(k, n)| (n, -k)).map(|(k, _)| k as f64 / 1000.0)
+}
